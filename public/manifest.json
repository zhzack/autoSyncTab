{
  "manifest_version": 3,
  "name": "autoSyncTab",
  "version": "0.2.0",
  "description": "轻量优雅的标签页收纳管理插件，支持分组整理、搜索恢复与 Google Drive 云端备份同步",
  "key": "",
  "permissions": [
    "tabs",
    "storage",
    "contextMenus",
    "identity"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "autoSyncTab - 标签页收纳",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
