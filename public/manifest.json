{
  "manifest_version": 3,
  "name": "autoSyncTab",
  "version": "0.3.0",
  "description": "轻量优雅的标签页收纳管理插件，支持分组整理、搜索恢复与 Google Drive 云端自动同步",
  "key": "",
  "permissions": [
    "tabs",
    "storage",
    "contextMenus",
    "identity",
    "alarms",
    "bookmarks"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "打开 autoSyncTab 弹窗"
    },
    "stash-all-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "mac": "Alt+Shift+A"
      },
      "description": "一键收纳当前窗口全部标签页"
    },
    "stash-current-tab": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "仅收纳当前标签页"
    },
    "open-manager": {
      "suggested_key": {
        "default": "Alt+Shift+M",
        "mac": "Alt+Shift+M"
      },
      "description": "打开标签页管理页"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "autoSyncTab - 标签页收纳",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
